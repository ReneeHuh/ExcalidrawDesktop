<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ExcalidrawDesktop.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:ExcalidrawDesktop.App.Pages"
    Title="Excalidraw Desktop — Starting…">
    <Grid
        x:Name="MainLayout"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        AllowDrop="True"
        DragOver="OnFileDragOver"
        Drop="OnFileDrop"
        Loaded="OnMainLayoutLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarContainer"
            Grid.Row="0"
            Height="48"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Loaded="OnTitleBarLoaded"
            SizeChanged="OnTitleBarSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInset" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightInset" Width="0" />
            </Grid.ColumnDefinitions>

            <TabView
                x:Name="DocumentTabs"
                Grid.Column="1"
                Height="48"
                VerticalAlignment="Top"
                AddTabButtonClick="OnAddTabButtonClick"
                AutomationProperties.AutomationId="DocumentTabs"
                AutomationProperties.Name="Open drawings"
                CanReorderTabs="True"
                CloseButtonOverlayMode="Auto"
                IsAddTabButtonVisible="True"
                SelectionChanged="OnTabSelectionChanged"
                TabDragCompleted="OnTabDragCompleted"
                TabCloseRequested="OnTabCloseRequested">
                <TabView.TabStripHeader>
                    <MenuBar
                        Padding="0"
                        Background="Transparent"
                        AutomationProperties.AutomationId="ApplicationMenu"
                        AutomationProperties.Name="Application menu">
                        <MenuBarItem
                            x:Name="FileMenu"
                            Title="File"
                            AutomationProperties.AutomationId="FileMenu">
                            <MenuFlyoutItem
                                Text="New tab"
                                KeyboardAcceleratorTextOverride="Ctrl+N"
                                Click="OnFileNewTabClick" />
                            <MenuFlyoutItem
                                Text="Open…"
                                KeyboardAcceleratorTextOverride="Ctrl+O"
                                Click="OnFileOpenClick" />
                            <MenuFlyoutSubItem
                                x:Name="RecentFilesMenu"
                                Text="Recent" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                x:Name="SaveMenuItem"
                                Text="Save"
                                KeyboardAcceleratorTextOverride="Ctrl+S"
                                Click="OnFileSaveClick" />
                            <MenuFlyoutItem
                                x:Name="SaveAsMenuItem"
                                Text="Save as…"
                                KeyboardAcceleratorTextOverride="Ctrl+Shift+S"
                                Click="OnFileSaveAsClick" />
                            <MenuFlyoutItem
                                x:Name="SaveAllMenuItem"
                                Text="Save all"
                                KeyboardAcceleratorTextOverride="Ctrl+Alt+S"
                                Click="OnFileSaveAllClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                x:Name="CloseTabMenuItem"
                                Text="Close tab"
                                KeyboardAcceleratorTextOverride="Ctrl+W"
                                Click="OnFileCloseTabClick" />
                            <MenuFlyoutItem
                                Text="Close window"
                                KeyboardAcceleratorTextOverride="Ctrl+Shift+W"
                                Click="OnFileCloseWindowClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                Text="Settings"
                                Click="OnSettingsClick" />
                            <MenuFlyoutItem
                                Text="Exit"
                                Click="OnFileExitClick" />
                        </MenuBarItem>
                    </MenuBar>
                </TabView.TabStripHeader>
                <TabView.TabStripFooter>
                    <Grid
                        x:Name="WindowDragRegion"
                        MinWidth="188"
                        Background="Transparent"
                        AutomationProperties.AutomationId="WindowDragRegion"
                        AutomationProperties.Name="Window drag region" />
                </TabView.TabStripFooter>
                <TabView.KeyboardAccelerators>
                    <KeyboardAccelerator
                        Key="T"
                        Modifiers="Control"
                        Invoked="OnNewTabAcceleratorInvoked" />
                    <KeyboardAccelerator
                        Key="N"
                        Modifiers="Control"
                        Invoked="OnNewTabAcceleratorInvoked" />
                    <KeyboardAccelerator
                        Key="W"
                        Modifiers="Control"
                        Invoked="OnCloseTabAcceleratorInvoked" />
                    <KeyboardAccelerator
                        Key="O"
                        Modifiers="Control"
                        Invoked="OnOpenAcceleratorInvoked" />
                    <KeyboardAccelerator
                        Key="S"
                        Modifiers="Control"
                        Invoked="OnSaveAcceleratorInvoked" />
                    <KeyboardAccelerator
                        Key="S"
                        Modifiers="Control,Shift"
                        Invoked="OnSaveAsAcceleratorInvoked" />
                    <KeyboardAccelerator
                        Key="W"
                        Modifiers="Control,Shift"
                        Invoked="OnCloseWindowAcceleratorInvoked" />
                    <KeyboardAccelerator
                        Key="S"
                        Modifiers="Control,Menu"
                        Invoked="OnSaveAllAcceleratorInvoked" />
                    <KeyboardAccelerator
                        Key="Tab"
                        Modifiers="Control"
                        Invoked="OnNextTabAcceleratorInvoked" />
                    <KeyboardAccelerator
                        Key="Tab"
                        Modifiers="Control,Shift"
                        Invoked="OnPreviousTabAcceleratorInvoked" />
                </TabView.KeyboardAccelerators>
            </TabView>

            <Button
                x:Name="SettingsButton"
                Grid.Column="2"
                Width="36"
                Height="32"
                Margin="4,0,8,0"
                Padding="0"
                Background="Transparent"
                BorderBrush="Transparent"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="SettingsButton"
                AutomationProperties.Name="Show Settings tab"
                Click="OnSettingsButtonClick"
                ToolTipService.ToolTip="Show Settings tab">
                <FontIcon
                    FontSize="16"
                    Glyph="&#xE713;" />
            </Button>

        </Grid>

        <Grid
            x:Name="EditorHost"
            Grid.Row="1" />

        <pages:SettingsPage
            x:Name="AppSettingsPage"
            Grid.Row="1"
            Visibility="Collapsed" />
    </Grid>
</Window>
