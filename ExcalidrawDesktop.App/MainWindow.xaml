<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ExcalidrawDesktop.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:ExcalidrawDesktop.App.Pages">
    <Grid
        x:Name="MainLayout"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        AllowDrop="True"
        DragOver="OnFileDragOver"
        Drop="OnFileDrop"
        Loaded="OnMainLayoutLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarContainer"
            Grid.Row="0"
            Height="48"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Loaded="OnTitleBarLoaded"
            SizeChanged="OnTitleBarSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInset" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightInset" Width="0" />
            </Grid.ColumnDefinitions>

            <TabView
                x:Name="DocumentTabs"
                x:Uid="DocumentTabs"
                Grid.Column="1"
                Height="48"
                VerticalAlignment="Top"
                AddTabButtonClick="OnAddTabButtonClick"
                AutomationProperties.AutomationId="DocumentTabs"
                AutomationProperties.Name="Open drawings"
                CanReorderTabs="True"
                CanTearOutTabs="True"
                CloseButtonOverlayMode="Auto"
                IsAddTabButtonVisible="True"
                SelectionChanged="OnTabSelectionChanged"
                TabDragCompleted="OnTabDragCompleted"
                TabTearOutWindowRequested="OnTabTearOutWindowRequested"
                TabTearOutRequested="OnTabTearOutRequested"
                ExternalTornOutTabsDropping="OnExternalTornOutTabsDropping"
                ExternalTornOutTabsDropped="OnExternalTornOutTabsDropped"
                TabCloseRequested="OnTabCloseRequested">
                <TabView.TabStripHeader>
                    <MenuBar
                        x:Uid="ApplicationMenu"
                        Padding="0"
                        Background="Transparent"
                        AutomationProperties.AutomationId="ApplicationMenu"
                        AutomationProperties.Name="Application menu">
                        <MenuBarItem
                            x:Name="FileMenu"
                            x:Uid="FileMenu"
                            Title="File"
                            AutomationProperties.AutomationId="FileMenu">
                            <MenuFlyoutItem
                                x:Uid="NewTabMenuItem"
                                Text="New tab"
                                KeyboardAcceleratorTextOverride="Ctrl+N"
                                Click="OnFileNewTabClick" />
                            <MenuFlyoutItem
                                x:Uid="NewWindowMenuItem"
                                Text="New window"
                                KeyboardAcceleratorTextOverride="Ctrl+Shift+N"
                                Click="OnFileNewWindowClick" />
                            <MenuFlyoutItem
                                x:Uid="OpenMenuItem"
                                Text="Open…"
                                KeyboardAcceleratorTextOverride="Ctrl+O"
                                Click="OnFileOpenClick" />
                            <MenuFlyoutSubItem
                                x:Name="RecentFilesMenu"
                                x:Uid="RecentFilesMenu"
                                Text="Recent" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                x:Name="SaveMenuItem"
                                x:Uid="SaveMenuItem"
                                Text="Save"
                                KeyboardAcceleratorTextOverride="Ctrl+S"
                                Click="OnFileSaveClick" />
                            <MenuFlyoutItem
                                x:Name="SaveAsMenuItem"
                                x:Uid="SaveAsMenuItem"
                                Text="Save as…"
                                KeyboardAcceleratorTextOverride="Ctrl+Shift+S"
                                Click="OnFileSaveAsClick" />
                            <MenuFlyoutItem
                                x:Name="SaveAllMenuItem"
                                x:Uid="SaveAllMenuItem"
                                Text="Save all"
                                KeyboardAcceleratorTextOverride="Ctrl+Alt+S"
                                Click="OnFileSaveAllClick" />
                            <MenuFlyoutItem
                                x:Name="ExportPngMenuItem"
                                x:Uid="ExportPngMenuItem"
                                Text="Export whole drawing as PNG…"
                                AutomationProperties.AutomationId="ExportPngMenuItem"
                                Click="OnFileExportPngClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                x:Name="CloseTabMenuItem"
                                x:Uid="CloseTabMenuItem"
                                Text="Close tab"
                                KeyboardAcceleratorTextOverride="Ctrl+W"
                                Click="OnFileCloseTabClick" />
                            <MenuFlyoutItem
                                x:Uid="CloseWindowMenuItem"
                                Text="Close window"
                                KeyboardAcceleratorTextOverride="Ctrl+Shift+W"
                                Click="OnFileCloseWindowClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                x:Name="SettingsMenuItem"
                                x:Uid="SettingsMenuItem"
                                Text="Settings"
                                Click="OnSettingsClick" />
                            <MenuFlyoutItem
                                x:Uid="ExitMenuItem"
                                Text="Exit"
                                Click="OnFileExitClick" />
                        </MenuBarItem>
                    </MenuBar>
                </TabView.TabStripHeader>
                <TabView.TabStripFooter>
                    <Grid
                        x:Name="WindowDragRegion"
                        x:Uid="WindowDragRegion"
                        MinWidth="188"
                        Background="Transparent"
                        AutomationProperties.AutomationId="WindowDragRegion"
                        AutomationProperties.Name="Window drag region" />
                </TabView.TabStripFooter>
                <TabView.KeyboardAccelerators>
                    <KeyboardAccelerator
                        Key="T"
                        Modifiers="Control"
                        Invoked="OnNewTabAcceleratorInvoked" />
                    <KeyboardAccelerator
                        Key="N"
                        Modifiers="Control"
                        Invoked="OnNewTabAcceleratorInvoked" />
                    <KeyboardAccelerator
                        Key="N"
                        Modifiers="Control,Shift"
                        Invoked="OnNewWindowAcceleratorInvoked" />
                    <KeyboardAccelerator
                        Key="W"
                        Modifiers="Control"
                        Invoked="OnCloseTabAcceleratorInvoked" />
                    <KeyboardAccelerator
                        Key="O"
                        Modifiers="Control"
                        Invoked="OnOpenAcceleratorInvoked" />
                    <KeyboardAccelerator
                        Key="S"
                        Modifiers="Control"
                        Invoked="OnSaveAcceleratorInvoked" />
                    <KeyboardAccelerator
                        Key="S"
                        Modifiers="Control,Shift"
                        Invoked="OnSaveAsAcceleratorInvoked" />
                    <KeyboardAccelerator
                        Key="W"
                        Modifiers="Control,Shift"
                        Invoked="OnCloseWindowAcceleratorInvoked" />
                    <KeyboardAccelerator
                        Key="S"
                        Modifiers="Control,Menu"
                        Invoked="OnSaveAllAcceleratorInvoked" />
                    <KeyboardAccelerator
                        Key="Tab"
                        Modifiers="Control"
                        Invoked="OnNextTabAcceleratorInvoked" />
                    <KeyboardAccelerator
                        Key="Tab"
                        Modifiers="Control,Shift"
                        Invoked="OnPreviousTabAcceleratorInvoked" />
                </TabView.KeyboardAccelerators>
            </TabView>

            <Button
                x:Name="SettingsButton"
                x:Uid="SettingsButton"
                Grid.Column="2"
                Width="36"
                Height="32"
                Margin="4,0,8,0"
                Padding="0"
                Background="Transparent"
                BorderBrush="Transparent"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="SettingsButton"
                AutomationProperties.Name="Show Settings tab"
                Click="OnSettingsButtonClick">
                <FontIcon
                    FontSize="16"
                    Glyph="&#xE713;" />
            </Button>

        </Grid>

        <Grid
            x:Name="EditorHost"
            Grid.Row="1" />

        <pages:SettingsPage
            x:Name="AppSettingsPage"
            Grid.Row="1"
            Visibility="Collapsed" />

        <Border
            x:Name="StatusBar"
            x:Uid="StatusBar"
            Grid.Row="2"
            Height="32"
            Padding="10,0"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            AutomationProperties.AccessibilityView="Content"
            AutomationProperties.AutomationId="DocumentStatusBar"
            AutomationProperties.Name="Drawing status">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="StatusDocumentText"
                    x:Uid="StatusDocumentText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="Untitled"
                    TextTrimming="CharacterEllipsis"
                    AutomationProperties.AccessibilityView="Content"
                    AutomationProperties.AutomationId="StatusDocumentText" />

                <TextBlock
                    x:Name="StatusStateText"
                    x:Uid="StatusStateText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="New drawing"
                    AutomationProperties.AccessibilityView="Content"
                    AutomationProperties.AutomationId="StatusStateText"
                    AutomationProperties.LiveSetting="Polite" />

                <Button
                    x:Name="StatusActionButton"
                    Grid.Column="1"
                    MinHeight="24"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                    BorderThickness="0"
                    FontSize="12"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="StatusActionButton"
                    Click="OnStatusActionClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
