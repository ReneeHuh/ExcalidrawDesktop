<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ExcalidrawDesktop.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:ExcalidrawDesktop.App.Views.Shared">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- TabView reads these at construction, before local XAML resources are applied. -->
            <x:Double x:Key="TabViewItemMinWidth">100</x:Double>
            <x:Double x:Key="TabViewItemMaxWidth">220</x:Double>
            <shared:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
