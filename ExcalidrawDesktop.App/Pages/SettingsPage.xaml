<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ExcalidrawDesktop.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <Grid
            MaxWidth="760"
            Margin="32,24,32,24"
            HorizontalAlignment="Stretch"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Uid="AppearanceSection"
                Grid.Row="0"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="Appearance" />
            <controls:SettingsCard
                x:Uid="ThemeSettingsCard"
                Grid.Row="1"
                Header="App frame theme"
                Description="Choose the appearance of the native title bar, menus, and settings page.">
                <ComboBox
                    x:Name="ThemePicker"
                    MinWidth="140"
                    SelectionChanged="OnPreferenceChanged">
                    <ComboBoxItem x:Uid="ThemeSystemOption" Content="Use system setting" Tag="System" />
                    <ComboBoxItem x:Uid="ThemeLightOption" Content="Light" Tag="Light" />
                    <ComboBoxItem x:Uid="ThemeDarkOption" Content="Dark" Tag="Dark" />
                </ComboBox>
            </controls:SettingsCard>

            <TextBlock
                x:Uid="LanguageSection"
                Grid.Row="2"
                Margin="0,16,0,0"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="Language" />
            <controls:SettingsCard
                x:Uid="LanguageSettingsCard"
                Grid.Row="3"
                Header="Application language"
                Description="Choose the language used by the desktop shell and editor. Changes apply after restart.">
                <ComboBox
                    x:Name="LanguagePicker"
                    MinWidth="200"
                    SelectionChanged="OnPreferenceChanged" />
            </controls:SettingsCard>
            <InfoBar
                x:Name="LanguageRestartInfoBar"
                x:Uid="LanguageRestartInfoBar"
                Grid.Row="4"
                IsClosable="False"
                IsOpen="False"
                Message="Restart Excalidraw Desktop to apply the selected language. Unsaved drawings will not be closed automatically."
                Severity="Informational"
                Title="Restart required" />

            <TextBlock
                x:Uid="StartupSection"
                Grid.Row="5"
                Margin="0,16,0,0"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="Startup" />
            <controls:SettingsCard
                x:Uid="ReopenTabsSettingsCard"
                Grid.Row="6"
                Header="Reopen saved drawing tabs"
                Description="Restore clean file-backed tabs from the previous session. Unsaved recovery is always preserved.">
                <ToggleSwitch
                    x:Name="ReopenSavedTabsToggle"
                    Toggled="OnPreferenceChanged" />
            </controls:SettingsCard>
            <controls:SettingsCard
                x:Uid="SaveDirtyDrawingsOnCloseSettingsCard"
                Grid.Row="7"
                Header="Automatically save dirty drawings on close"
                Description="Save changed drawings when closing a tab or window, or when exiting. Untitled drawings still ask where to save, and cancelling keeps the window open.">
                <ToggleSwitch
                    x:Name="SaveDirtyDrawingsOnCloseToggle"
                    Toggled="OnPreferenceChanged" />
            </controls:SettingsCard>

            <TextBlock
                x:Uid="PerformanceSection"
                Grid.Row="8"
                Margin="0,16,0,0"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="Performance" />
            <controls:SettingsCard
                x:Uid="SleepTabsSettingsCard"
                Grid.Row="9"
                Header="Sleep inactive tabs"
                Description="Suspend safe clean tabs after five inactive minutes to reduce background activity.">
                <ToggleSwitch
                    x:Name="SuspendInactiveTabsToggle"
                    Toggled="OnPreferenceChanged" />
            </controls:SettingsCard>
            <controls:SettingsCard
                x:Uid="UnloadTabsSettingsCard"
                Grid.Row="10"
                Header="Unload inactive editors"
                Description="Close safe clean WebViews after fifteen inactive minutes. Selecting the tab recreates its editor and resets undo history.">
                <ToggleSwitch
                    x:Name="UnloadInactiveTabsToggle"
                    Toggled="OnPreferenceChanged" />
            </controls:SettingsCard>

            <TextBlock
                x:Uid="AboutSection"
                Grid.Row="11"
                Margin="0,16,0,0"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="About" />
            <controls:SettingsCard
                x:Uid="AboutSettingsCard"
                Grid.Row="12"
                Header="Excalidraw Desktop"
                Description="A local-first WinUI desktop host for Excalidraw.">
                <TextBlock
                    x:Name="VersionText"
                    VerticalAlignment="Center" />
            </controls:SettingsCard>
            <InfoBar
                x:Name="SettingsPersistenceInfoBar"
                x:Uid="SettingsPersistenceInfoBar"
                Grid.Row="13"
                IsClosable="False"
                IsOpen="False"
                Severity="Error"
                Title="Settings could not be saved"
                Message="The selected preference is active for this session, but could not be saved. Check the settings location and retry."
                >
                <InfoBar.ActionButton>
                    <Button x:Uid="SettingsPersistenceRetryButton" Click="OnSettingsPersistenceRetry" />
                </InfoBar.ActionButton>
            </InfoBar>
        </Grid>
    </ScrollViewer>
</Page>
