<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ExcalidrawDesktop.App.Controls.DocumentTabContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ContentControl
            x:Name="EditorContainer"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <WebView2
                x:Uid="EditorWebView"
                AutomationProperties.AutomationId="ExcalidrawEditorWebView"
                AutomationProperties.Name="Excalidraw editor" />
        </ContentControl>

        <Border
            x:Name="StartupOverlay"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel
                MaxWidth="560"
                Margin="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <ProgressRing
                    x:Name="StartupProgress"
                    Width="36"
                    Height="36"
                    IsActive="True" />
                <TextBlock
                    x:Name="StartupStatus"
                    x:Uid="StartupStatus"
                    AutomationProperties.AutomationId="StartupStatusText"
                    AutomationProperties.LiveSetting="Assertive"
                    FontSize="18"
                    FontWeight="SemiBold"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Text="Starting Excalidraw Desktop…" />
                <TextBlock
                    x:Name="StartupGuidance"
                    AutomationProperties.AutomationId="StartupGuidanceText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <StackPanel
                    x:Name="FailureActions"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
                    <Button
                        x:Name="RetryEditorButton"
                        x:Uid="RetryEditorButton"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="RetryEditorButton"
                        AutomationProperties.Name="Retry starting this editor"
                        Click="OnRetryClick"
                        Content="Retry" />
                    <Button
                        x:Name="WebView2HelpButton"
                        x:Uid="WebView2HelpButton"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="WebView2HelpButton"
                        AutomationProperties.Name="Open Microsoft WebView2 install and repair help"
                        Click="OnWebView2HelpClick"
                        Content="WebView2 help"
                        Visibility="Collapsed" />
                    <Button
                        x:Uid="CloseFailedTabButton"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="CloseFailedTabButton"
                        AutomationProperties.Name="Close this failed drawing tab"
                        Click="OnCloseTabClick"
                        Content="Close tab" />
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
