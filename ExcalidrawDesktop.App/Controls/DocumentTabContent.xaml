<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ExcalidrawDesktop.App.Controls.DocumentTabContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ContentControl
            x:Name="EditorContainer"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <WebView2
                AutomationProperties.AutomationId="ExcalidrawEditorWebView"
                AutomationProperties.Name="Excalidraw editor" />
        </ContentControl>

        <Border
            x:Name="StartupOverlay"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            IsHitTestVisible="False">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <ProgressRing
                    x:Name="StartupProgress"
                    Width="36"
                    Height="36"
                    IsActive="True" />
                <TextBlock
                    x:Name="StartupStatus"
                    AutomationProperties.AutomationId="StartupStatusText"
                    Text="Starting Excalidraw Desktop…" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
